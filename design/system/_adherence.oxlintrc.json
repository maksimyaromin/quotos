{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/indicators/**",
              "components/shell/**",
              "components/subscription/**",
              "ui_kits/quotos/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|MonoLisa))/i]",
        "message": "Font not provided by the design system. Available: Inter, MonoLisa."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|warn|danger|info)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'warn' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|icon|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, icon, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|base|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'base' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CapacityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:remaining|reading|stale|height|style|key|ref|className|style|children)$/]",
        "message": "<CapacityBar> doesn't accept that prop. Declared props: remaining, reading, stale, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|active|disabled|label|onClick|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: size, active, disabled, label, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LimitWindow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|remaining|resetLabel|scope|stale|style|key|ref|className|style|children)$/]",
        "message": "<LimitWindow> doesn't accept that prop. Declared props: name, remaining, resetLabel, scope, stale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinnedFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:remaining|state|key|ref|className|style|children)$/]",
        "message": "<PinnedFigure> doesn't accept that prop. Declared props: remaining, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|beak|headerActions|footer|maxBodyHeight|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, beak, headerActions, footer, maxBodyHeight, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: state, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubscriptionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|provider|account|state|remaining|resetLabel|lastRead|windows|reason|pinned|expanded|actionLabel|onAction|onTogglePin|onToggleExpand|style|key|ref|className|style|children)$/]",
        "message": "<SubscriptionRow> doesn't accept that prop. Declared props: label, provider, account, state, remaining, resetLabel, lastRead, windows, reason, pinned, expanded, actionLabel, onAction, onTogglePin, onToggleExpand, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|mono|invalid|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, placeholder, mono, invalid, disabled, onChange, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
